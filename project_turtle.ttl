###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#TriaseDarurat
:TriaseDarurat rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :KasusPasien
                                                          [ rdf:type owl:Class ;
                                                            owl:unionOf ( :TerindikasiNoma
                                                                          :TerindikasiRabies
                                                                          :TerindikasiSnakebite
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty :memilikiTandaBahaya ;
                                                                            owl:someValuesFrom :TandaBahaya
                                                                          ]
                                                                        )
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :HasilDiagnosis ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :memilikiRujukanMedis ;
                                 owl:hasValue :SegeraMencariPertolonganPro
                               ] .


