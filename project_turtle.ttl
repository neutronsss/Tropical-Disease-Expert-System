                                                                     ]
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :mengalamiManifestasi ;
                                                                       owl:hasValue :ChagasDisease_DemamTinggi
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf :HasilDiagnosis .


