@prefix : <http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6> .

<http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#sumberRujukan
:sumberRujukan rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#disebabkan
:disebabkan rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#melibatkanGejala
:melibatkanGejala rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#memilikiPenanganan
:memilikiPenanganan rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#memilikiPenangananMandiri
:memilikiPenangananMandiri rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf :memilikiPenanganan .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#memilikiRujukanMedis
:memilikiRujukanMedis rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :memilikiPenanganan .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#memilikiTandaBahaya
:memilikiTandaBahaya rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#mengalamiGejala
:mengalamiGejala rdf:type owl:ObjectProperty ;
                 rdfs:domain :KasusPasien ;
                 rdfs:range :Gejala ;
                 owl:propertyChainAxiom ( :mengalamiManifestasi
                                          :melibatkanGejala
                                        ) .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#mengalamiManifestasi
:mengalamiManifestasi rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#menghubungkanPenyakit
:menghubungkanPenyakit rdf:type owl:ObjectProperty ;
                       owl:inverseOf :penyakitTerkait .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#pantanganMandiri
:pantanganMandiri rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#penyakitTerkait
:penyakitTerkait rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#punyaKontakLingkungan
:punyaKontakLingkungan rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#umumTerjadiPadaMusim
:umumTerjadiPadaMusim rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#mulaiDirasakanHariKe
:mulaiDirasakanHariKe rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ManifestasiGejala ;
                      rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#Gejala
:Gejala rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaDarurat
:GejalaDarurat rdf:type owl:Class ;
               rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaKhas
:GejalaKhas rdf:type owl:Class ;
            rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaKulit
:GejalaKulit rdf:type owl:Class ;
             rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaPencernaan
:GejalaPencernaan rdf:type owl:Class ;
                  rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaSensorik
:GejalaSensorik rdf:type owl:Class ;
                rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaSistemik
:GejalaSistemik rdf:type owl:Class ;
                rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#GejalaUmum
:GejalaUmum rdf:type owl:Class ;
            rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#HasilDiagnosis
:HasilDiagnosis rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#KasusPasien
:KasusPasien rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#LaranganTindakan
:LaranganTindakan rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#Lingkungan
:Lingkungan rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#ManifestasiGejala
:ManifestasiGejala rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :melibatkanGejala ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Gejala
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :menghubungkanPenyakit ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Penyakit
                                   ] .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#Musim
:Musim rdf:type owl:Class ;
       owl:equivalentClass [ rdf:type owl:Class ;
                             owl:oneOf ( :Hujan
                                         :Kemarau
                                       )
                           ] .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#PenangananMandiri
:PenangananMandiri rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#Penyakit
:Penyakit rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#PenyakitBakteri
:PenyakitBakteri rdf:type owl:Class ;
                 rdfs:subClassOf :Penyakit .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#PenyakitJamur
:PenyakitJamur rdf:type owl:Class ;
               rdfs:subClassOf :Penyakit .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#PenyakitParasit
:PenyakitParasit rdf:type owl:Class ;
                 rdfs:subClassOf :Penyakit .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#PenyakitToksin
:PenyakitToksin rdf:type owl:Class ;
                rdfs:subClassOf :Penyakit .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#PenyakitVirus
:PenyakitVirus rdf:type owl:Class ;
               rdfs:subClassOf :Penyakit .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#RujukanFaskes
:RujukanFaskes rdf:type owl:Class .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#TandaBahaya
:TandaBahaya rdf:type owl:Class ;
             rdfs:subClassOf :Gejala .


###  http://www.semanticweb.org/jimmysebastian/ontologies/2026/9/untitled-ontology-6#TerindikasiBuruliUlcer
:TerindikasiBuruliUlcer rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :KasusPasien
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :mengalamiManifestasi ;
                                                                     owl:hasValue :BuruliUlcer_BenjolanTanpaNyeri
                                                                   ]
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :mengalamiManifestasi ;
                                                                     owl:hasValue :BuruliUlcer_LukaBorok
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf :HasilDiagnosis .


